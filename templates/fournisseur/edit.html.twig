{% extends 'base.html.twig' %}

{% block title %}{% if fournisseur.id %}Modifier{% else %}Ajouter{% endif %} un fournisseur{% endblock %}

{% block content %}
    <div class="max-w-2xl mx-auto">
        <div class="md:flex md:items-center md:justify-between mb-8">
            <div class="min-w-0 flex-1">
                <h2 class="text-2xl font-bold leading-7 text-gray-900 sm:truncate sm:text-3xl sm:tracking-tight">
                    {% if fournisseur.id %}
                        {{ fournisseur.nom }}
                    {% else %}
                        Nouveau fournisseur
                    {% endif %}
                </h2>
            </div>
            <div class="mt-4 flex md:ml-4 md:mt-0">
            </div>
        </div>

        <div class="formWrapper">
            <form method="post">
                {{ form_widget(form._referer) }}
                {{ form_widget(form._token) }}

                {{ form_errors(form) }}

                <div class="space-y-12">
                    <div class="formSection">
                        <div>
                            <h2>Informations générales</h2>
                        </div>
                        <div class="formGrid">
                            <div class="col-span-full">
                                {{ form_label(form.nom, 'Nom') }}
                                <div class="mt-2">
                                    {{ form_widget(form.nom) }}
                                </div>
                                <div class="formErrors">
                                    {{ form_errors(form.nom) }}
                                </div>
                            </div>

                            <div class="col-span-full">
                                {{ form_label(form.adresse, 'Adresse') }}
                                <div class="mt-2">
                                    {{ form_widget(form.adresse) }}
                                </div>
                                <div class="formErrors">
                                    {{ form_errors(form.adresse) }}
                                </div>
                            </div>

                            <div class="sm:col-span-3">
                                {{ form_label(form.email, 'Email') }}
                                <div class="mt-2">
                                    {{ form_widget(form.email) }}
                                </div>
                                <div class="formErrors">
                                    {{ form_errors(form.email) }}
                                </div>
                            </div>

                            <div class="sm:col-span-3">
                                {{ form_label(form.telephone, 'Téléphone') }}
                                <div class="mt-2">
                                    {{ form_widget(form.telephone) }}
                                </div>
                                <div class="formErrors">
                                    {{ form_errors(form.telephone) }}
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="formSection">
                        <div>
                            <h2>Informations comptables</h2>
                        </div>
                        <div class="formGrid">
                            <div class="col-span-full">
                                {{ form_label(form.codeComptable, 'Code Comptable') }}
                                <div class="mt-2">
                                    {{ form_widget(form.codeComptable) }}
                                </div>
                                <div class="formErrors">
                                    {{ form_errors(form.codeComptable) }}
                                </div>
                            </div>

                            <div class="col-span-full">
                                {{ form_label(form.compteGeneral, 'Compte Général') }}
                                <div class="mt-2">
                                    {{ form_widget(form.compteGeneral) }}
                                </div>
                                <div class="formErrors">
                                    {{ form_errors(form.compteGeneral) }}
                                </div>
                            </div>

                            <div class="col-span-full">
                                {{ form_label(form.compteCharge, 'Compte Charge') }}
                                <div class="mt-2">
                                    {{ form_widget(form.compteCharge) }}
                                </div>
                                <div class="formErrors">
                                    {{ form_errors(form.compteCharge) }}
                                </div>
                            </div>

                            <div class="col-span-full">
                                {{ form_label(form.compteTva, 'Compte TVA') }}
                                <div class="mt-2">
                                    {{ form_widget(form.compteTva) }}
                                </div>
                                <div class="formErrors">
                                    {{ form_errors(form.compteTva) }}
                                </div>
                            </div>

                            <div class="col-span-full">
                                {{ form_label(form.journalAchat, 'Journal Achat') }}
                                <div class="mt-2">
                                    {{ form_widget(form.journalAchat) }}
                                </div>
                                <div class="formErrors">
                                    {{ form_errors(form.journalAchat) }}
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="mt-6 flex items-center justify-end gap-x-6">
                    <a href="{{ form._referer.vars.data ?? path('fournisseur_index') }}" class="button button--light">Annuler</a>
                    <button type="submit" class="rounded-md bg-teal-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-teal-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-teal-600">
                        Enregistrer
                    </button>
                </div>
            </form>

            {% if fournisseur.id %}
                <form method="post" action="{{ path('fournisseur_delete', {'id': fournisseur.id}) }}" 
                      onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer ce fournisseur ?');" class="contents">
                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ fournisseur.id) }}">
                    <button class="text-teal-600 hover:text-teal-900">Supprimer<span class="sr-only">, {{ fournisseur.nom }}</span></button>
                </form>
            {% endif %}
        </div>
    </div>
{% endblock %}